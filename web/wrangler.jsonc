{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "the-plan-web",
  "compatibility_date": "2026-09-18",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "the-plan.raregazzetto.me",
      "custom_domain": true
    }
  ]
}
