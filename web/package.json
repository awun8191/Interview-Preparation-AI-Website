{
  "name": "bun-react-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "briefs": "bun scripts/build-framework-briefs.ts",
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && bun build ./src/index.html --outdir=dist --sourcemap --target=browser --minify --define:process.env.NODE_ENV='\"production\"' --env='BUN_PUBLIC_*' && bun scripts/postbuild.ts",
    "deploy": "bun run build && wrangler deploy",
    "start": "NODE_ENV=production bun src/index.ts"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
